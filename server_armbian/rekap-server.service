[Unit]
Description=Rekap Proyek AI - Armbian Python Server & Telegram Backend
After=network.target mariadb.service mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rekap_server
Environment="SERVER_HOST=0.0.0.0"
Environment="SERVER_PORT=8000"
Environment="MYSQL_HOST=localhost"
Environment="MYSQL_PORT=3306"
Environment="MYSQL_USER=root"
Environment="MYSQL_PASSWORD="
Environment="MYSQL_DB=db_rekap_konstruksi"
Environment="API_KEY=armbian_secret_token_2026"
Environment="TELEGRAM_BOT_TOKEN="
Environment="TELEGRAM_CHAT_ID="
Environment="ENABLE_TELEGRAM_POLLER=true"
ExecStart=/usr/bin/python3 /opt/rekap_server/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
